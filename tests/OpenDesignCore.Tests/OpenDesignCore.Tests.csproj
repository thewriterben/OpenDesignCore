<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.11.1]" />
    <PackageReference Include="xunit" Version="[2.9.2]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[2.8.2]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenDesignCore\OpenDesignCore.csproj" />
    <ProjectReference Include="..\..\src\OpenDesignCore.Mcp\OpenDesignCore.Mcp.csproj" />
  </ItemGroup>

  <!--
    Reference tests (tests/reference/) compile into this assembly so that
    `dotnet test` stays one command. They live in their own directory because
    they are a different kind of test — known answers rather than pinned
    outputs — not because they need a separate runner. See tests/reference/README.md.
  -->
  <ItemGroup>
    <Compile Include="..\reference\**\*.cs" LinkBase="Reference" />
  </ItemGroup>

</Project>
